{
  "name": "dalilcom-monorepo",
  "version": "1.0.15",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/dalilcom-web",
    "dev:app": "npm run start --workspace=apps/dalilcom-app",
    "dev:api": "npm run dev --workspace=apps/dalilcom-api",
    "build:web": "npm run build --workspace=apps/dalilcom-web",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "node tools/clean.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.0",
    "expo": "~52.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
