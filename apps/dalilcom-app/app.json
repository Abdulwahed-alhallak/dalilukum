{
  "expo": {
    "name": "دليلكم",
    "slug": "dalilukum",
    "version": "1.0.14",
    "orientation": "portrait",
    "scheme": "com.dalilukum.app",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/logo-square.png",
    "android": {
      "package": "com.dalilukum.app",
      "versionCode": 17,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.dalilukum.app",
      "supportsTablet": true,
      "buildNumber": "17"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-image-picker"
    ]
  }
}
